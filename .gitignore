# ==========================================
# StudyMate AI - .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
*.pem
*.key
*.keystore
*.jks

# Google API Credentials & OAuth Tokens
credentials.json
token.pickle
backend/credentials.json
backend/token.pickle

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/
frontend/.vite/

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Temporary Uploads & Logs
uploads/
backend/uploads/
*.pdf
*.log
*.tmp

# Release artifacts
*.zip
*.tar.gz
checksums.txt