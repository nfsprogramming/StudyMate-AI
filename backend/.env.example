# NVIDIA NIM API Keys (Required for Socratic AI Chat & Multimodal Document Processing)
# Obtain free/developer keys from: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VISION_API_KEY=your_nvidia_vision_api_key_here

# Google Classroom & Drive API Configuration (Optional)
# If not using credentials.json directly in backend/, you can configure via environment:
# GOOGLE_CREDENTIALS={"web":{"client_id":"...","client_secret":"..."}}
# GOOGLE_TOKEN={"token":"...","refresh_token":"..."}
